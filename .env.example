# Port HTTP server
PORT=3000

# Path file SQLite (relatif terhadap root project)
DB_PATH=db/wa-bot.db

# Direktori penyimpanan media upload (relatif terhadap root project)
UPLOAD_DIR=uploads

# Direktori session WhatsApp Baileys (creds.json + keys; relatif terhadap root project)
AUTH_DIR=.baileys_auth

# Rate default (pesan per menit) bila tidak diisi saat create broadcast
DEFAULT_RATE_PER_MINUTE=20

# Batas atas rate yang diterima (untuk validasi)
MAX_RATE_PER_MINUTE=3600

# Maksimal ukuran upload gambar (bytes)
MAX_UPLOAD_SIZE=5242880
