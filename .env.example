# Port HTTP server
PORT=3000

# Path file SQLite (relatif terhadap root project)
DB_PATH=db/wa-bot.db

# Direktori penyimpanan media upload (relatif terhadap root project)
UPLOAD_DIR=uploads

# Direktori session WhatsApp (profil LocalAuth whatsapp-web.js; relatif terhadap root project)
AUTH_DIR=.wwebjs_auth

# Rate default (pesan per menit) bila tidak diisi saat create broadcast
DEFAULT_RATE_PER_MINUTE=20

# Batas atas rate yang diterima. Juga jadi batas BAWAH jeda per pesan
# (delaySeconds minimal = 60 / MAX_RATE_PER_MINUTE) supaya plafon anti-ban
# tidak bisa ditembus lewat jalur delaySeconds.
MAX_RATE_PER_MINUTE=3600

# Batas atas jeda per pesan (detik)
MAX_DELAY_SECONDS=3600

# Jeda pemanasan (detik) sebelum pesan pertama broadcast — mitigasi anti-ban untuk
# device baru. 0 = nonaktif.
WARMUP_DELAY_SECONDS=0

# Maksimal ukuran upload gambar (bytes)
MAX_UPLOAD_SIZE=5242880

# (dihapus) API_KEY lama sudah diganti autentikasi account-service di bawah.
# Nama headernya bentrok: X-API-Key kini berarti API key SERVICE ACCOUNT
# milik account-service, bukan kunci lokal.

# --- Autentikasi (account-service) -------------------------------------------
# KOSONG = autentikasi NONAKTIF dan seluruh /api terbuka. Server mencetak
# peringatan mencolok saat itu terjadi — jangan dibiarkan di production.
ACCOUNT_SERVICE_URL=
# Izin yang wajib dipegang. Service key `wa-bot` di account-service otomatis
# menjadi `wa-bot:*` di dalam JWT.
AUTH_REQUIRED_PERMISSION=wa-bot:*
AUTH_ISSUER=account-service
# Kosong = `aud` tidak diperiksa. account-service sendiri TIDAK memvalidasi aud,
# jadi penegakannya ada di sisi kita.
AUTH_AUDIENCE=
AUTH_CLOCK_TOLERANCE_SECONDS=30
ACCOUNT_PUBLIC_KEY_TTL_SECONDS=86400
ACCOUNT_WHOAMI_CACHE_SECONDS=60
ACCOUNT_SERVICE_TIMEOUT_MS=5000

# API key opsional untuk /api. KOSONG = nonaktif (cocok bila hanya diakses dari
# localhost). Isi bila port bisa dijangkau pihak lain — tanpa ini siapa pun yang
# menjangkau port dapat mengirim WhatsApp dari nomor yang terhubung.
# Set juga di browser: localStorage.setItem('WA_API_KEY', '<kunci yang sama>')
API_KEY=

# Origin web yang diizinkan CORS (pisah koma, mis. http://localhost:5173); kosong = same-origin
CORS_ORIGINS=

# Percobaan ulang pengiriman saat WhatsApp Web memuat ulang halamannya sendiri.
# Hanya berlaku untuk kegagalan yang TERBUKTI belum sempat dieksekusi (frame
# dilepas / konteks hilang), jadi tidak berisiko membuat pesan terkirim dua kali.
# Kegagalan yang statusnya tidak pasti (mis. "Target closed") tetap tidak diulang.
SEND_MAX_ATTEMPTS=3
SEND_RETRY_DELAY_SECONDS=3
